{
  "name": "jaffre",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sim": "tsx scripts/sim.ts",
    "devkit": "npm run devkit -w packages/ui",
    "dev": "npm run dev -w apps/server"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.19",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.1.3",
    "eslint": "^9.26.0",
    "fast-check": "^4.1.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vitest": "^3.1.3",
    "wrangler": "^4.14.4"
  }
}
