{
  "name": "jaffre",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b && tsc -p apps/server && tsc -p apps/web && tsc -p packages/ui",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "e2e": "playwright test -c apps/web/playwright.config.ts",
    "e2e:scenes": "playwright test -c apps/web/playwright.config.ts scenes.spec.ts",
    "shots": "playwright test -c apps/web/playwright.shots.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sim": "tsx scripts/sim.ts",
    "botbench": "tsx scripts/botbench.ts",
    "verify:deploy": "tsx scripts/verify-deploy.ts",
    "audit:contrast": "node scripts/contrast-audit.mjs packages/ui/src/tokens.css",
    "devkit": "npm run devkit -w packages/ui",
    "dev": "npm run dev -w apps/server",
    "shots:sweep": "playwright test -c apps/web/playwright.shots.config.ts --grep \"desktop-dark|desktop-light|small-desktop-dark|small-desktop-light|tablet-dark|tablet-light|phone-dark|phone-light\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^10.15.0",
    "fast-check": "^4.11.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  }
}
